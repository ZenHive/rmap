<!DOCTYPE html>
<!--
  rmap render --html — self-contained static roadmap view.
  Ships inside the rmap binary via include_str!. Single file: inline CSS + JS,
  no CDN, no framework, no build step. Size target <50KB per page.
  Agents: parse the rmap-data JSON island near the end, do not scrape the DOM.
  Styling is the shared "engineering blueprint console" design system
  (templates/_styles.css), injected verbatim so this and the portfolio view
  speak one visual language.
-->
<html lang="en">
{% import "components.html" as c %}
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ project }} — Roadmap</title>
<style>{{ styles | safe }}</style>
</head>
<body>

<header id="filter-bar">
  <span class="brand">{{ project }}</span>
  <span class="filter-label">markers</span>
  <button class="chip active" data-marker="all">all</button>
  {% for marker in all_markers %}
  <button class="chip" data-marker="{{ marker }}">{{ marker }}</button>
  {% endfor %}
  <span class="filter-label">status</span>
  <button class="status-toggle active" data-toggle-status="pending">⏸ pending</button>
  <button class="status-toggle active" data-toggle-status="in_progress">→ in progress</button>
  <button class="status-toggle active" data-toggle-status="blocked">⛔ blocked</button>
  <button class="status-toggle active" data-toggle-status="done">✓ done</button>
</header>

<main>
{% for phase in phases %}{{ c.phase_section(phase) }}{% endfor %}
{{ c.dep_graph(dag, "main") }}
</main>

<footer>Rendered by rmap on {{ today }} — static snapshot, not live. ROADMAP.md stays canonical.</footer>

<script id="rmap-data" type="application/json">{{ data_island | safe }}</script>

<script>
(function () {
  var cards = document.querySelectorAll(".task-card");
  var activeMarker = "all";
  var activeStatuses = { pending: true, in_progress: true, blocked: true, done: true };

  function apply() {
    cards.forEach(function (card) {
      var markers = (card.dataset.markers || "").split(" ").filter(Boolean);
      var markerOk = activeMarker === "all" || markers.indexOf(activeMarker) !== -1;
      var statusOk = !!activeStatuses[card.dataset.status];
      card.classList.toggle("hidden", !(markerOk && statusOk));
    });
  }

  document.querySelectorAll(".chip").forEach(function (btn) {
    btn.addEventListener("click", function () {
      document.querySelectorAll(".chip").forEach(function (b) { b.classList.remove("active"); });
      btn.classList.add("active");
      activeMarker = btn.dataset.marker;
      apply();
    });
  });

  document.querySelectorAll(".status-toggle").forEach(function (btn) {
    btn.addEventListener("click", function () {
      var st = btn.dataset.toggleStatus;
      activeStatuses[st] = !activeStatuses[st];
      btn.classList.toggle("active", activeStatuses[st]);
      apply();
    });
  });
})();
</script>

</body>
</html>
