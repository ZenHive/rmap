<!DOCTYPE html>
<!--
  rmap render --html --multi — self-contained static portfolio board.
  Repos are rails; click a rail to expand its full board inline. Cross-repo
  relations (each task's cross_repo field) are drawn as cords in the left
  gutter, recomputed by JS after layout/expansion.
  Agents: parse the rmap-data JSON island near the end ({"projects":[…]}, one
  exported envelope per repo) and rmap-relations; do not scrape the DOM.
-->
<html lang="en">
{% import "components.html" as c %}
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Portfolio board — {{ repos | length }} repos</title>
<style>{{ styles | safe }}</style>
</head>
<body class="is-portfolio">
<!--
  THESIS: the whole portfolio as one T-card planning board; each repo is a rail,
  the dispatch racks pull every ready / active / held card across repos to the
  top. Refuses the dark neon kanban dashboard.
  OWN-WORLD: anodized aluminium, engraved plates, lane-coloured card stock,
  red HOLD / VOID stamps, index-card reverse for specs, red cords for blocks.
  STORY: what can I dispatch anywhere, what is stuck and why, how far is each
  repo, how do repos depend on each other; pull any card to read its spec.
  FIRST VIEWPORT: portfolio plate + counters, then Dispatch racks across repos.
  FORM: T-card planning board, grounded list #7, seed c29fcb8f.
  FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
-->

<header class="masthead">
  <div class="masthead-inner">
    <div class="nameplate">
      <span class="nameplate-kind">rmap portfolio</span>
      <h1 class="nameplate-name">{{ repos | length }} repos</h1>
    </div>
    {{ c.counters(counts) }}
  </div>
  <div class="masthead-strip">
    {{ c.composition(segments, "All tasks by lane") }}
    <p class="snapshot">Snapshot {{ today }} · static, not live · each tasks.toml stays canonical</p>
  </div>
</header>

<div class="controls">
  {{ c.switches([]) }}
  <div class="control-tail">
    <label class="search"><span class="visually-hidden">Filter repos</span>
      <input id="repo-search" type="search" placeholder="Filter repos" autocomplete="off">
    </label>
    <button id="expand-all" type="button" class="switch" aria-pressed="false"><span class="lamp"></span>Expand all</button>
  </div>
</div>

<main>
{{ c.racks_board(racks, true) }}

<section class="boards" aria-labelledby="boards-title">
  <h2 id="boards-title" class="board-title">Repos</h2>
  <div class="repos" id="repos">
    <svg class="relations-overlay" id="relations-overlay" aria-hidden="true">
      <defs>
        <marker id="rel-arrow" markerWidth="9" markerHeight="9" refX="6" refY="3"
          orient="auto" markerUnits="strokeWidth">
          <path d="M0,0 L0,6 L8,3 z" fill="context-stroke"></path>
        </marker>
      </defs>
    </svg>

    {% for repo in repos %}
    <section class="repo-row" id="repo-{{ repo.slug }}" data-slug="{{ repo.slug }}"
      data-name="{{ repo.project }}" data-has-rel="{{ repo.has_rel }}" data-repo="{{ repo.index }}">
      <span class="repo-anchor" aria-hidden="true"></span>
      <div class="repo-row-header" role="button" tabindex="0" aria-expanded="false">
        <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M4 2.5 7.5 6 4 9.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span class="repo-name">{{ repo.project }}<span class="repo-path">{{ repo.path }}</span></span>
        {{ c.composition(repo.segments, repo.project ~ " lanes") }}
        <span class="repo-counts">
          <span class="rc lane-ready{% if repo.counts.ready == 0 %} is-zero{% endif %}" title="ready"><b>{{ repo.counts.ready }}</b>rdy</span>
          <span class="rc lane-active{% if repo.counts.active == 0 %} is-zero{% endif %}" title="active"><b>{{ repo.counts.active }}</b>act</span>
          <span class="rc lane-hold{% if repo.counts.hold == 0 %} is-zero{% endif %}" title="hold"><b>{{ repo.counts.hold }}</b>hold</span>
          <span class="rc lane-done" title="done"><b>{{ repo.counts.done }}</b>/{{ repo.counts.total }}</span>
        </span>
      </div>
      {% if repo.rel_tags %}
      <div class="repo-rel-tags">
        {% for tag in repo.rel_tags %}
        <span class="rel-tag {{ tag.relation }}">{{ tag.relation | replace("_", " ") }} {{ tag.repo }} {{ tag.task_id }}</span>
        {% endfor %}
      </div>
      {% endif %}
      <div class="repo-detail">
        {% for phase in repo.phases %}{{ c.phase_section(phase) }}{% endfor %}
        {% if repo.phases %}{{ c.dep_graph(repo.dag, repo.slug) }}{% else %}<p class="phase-empty">No phases declared.</p>{% endif %}
      </div>
    </section>
    {% endfor %}
  </div>
</section>
</main>

{{ c.detail_panel() }}

<footer>Rendered by rmap on {{ today }}. Click a rail to open its board, any card to pull it out; Esc puts it back.</footer>

<script id="rmap-data" type="application/json">{{ data_island | safe }}</script>
<script id="rmap-relations" type="application/json">{{ relations_json | safe }}</script>
<script>{{ script | safe }}</script>
</body>
</html>
